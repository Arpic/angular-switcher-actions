<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>ch.namlin.angular-switcher-actions</id>

    <name>Angular Switcher Actions</name>

    <description><![CDATA[
    This plugin introduces actions for switching to commonly used file types in angular project:
    <ul>
        <li>Templates (html, svg)</li>
        <li>Components (js, ts)</li>
        <li>Tests (spec)</li>
        <li>Style (css, scss, less, styl)</li>
    </ul>
  ]]></description>
    <vendor email="plugins.jetbrains@namlin.aleeas.com">Maxime Ameho</vendor>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">

    </extensions>
    <actions resource-bundle="messages.AGSActionsBundle">
        <action id="ch.namlin.angularswitchershortcuts.action.SwitchToTemplate"
                class="ch.namlin.angularswitchershortcuts.action.SwitchToTemplate">
            <add-to-group group-id="EditorPopupMenu.GoTo" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl I" second-keystroke="H"/>
        </action>
        <action id="ch.namlin.angularswitchershortcuts.action.SwitchToComponent"
                class="ch.namlin.angularswitchershortcuts.action.SwitchToComponent">
            <add-to-group group-id="EditorPopupMenu.GoTo" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl I" second-keystroke="C"/>
        </action>
        <action id="ch.namlin.angularswitchershortcuts.action.SwitchToStyle"
                class="ch.namlin.angularswitchershortcuts.action.SwitchToStyle">
            <add-to-group group-id="EditorPopupMenu.GoTo" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl I" second-keystroke="S"/>
        </action>
        <action id="ch.namlin.angularswitchershortcuts.action.SwitchToTest"
                class="ch.namlin.angularswitchershortcuts.action.SwitchToTest">
            <add-to-group group-id="EditorPopupMenu.GoTo" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl I" second-keystroke="T"/>
        </action>
    </actions>
</idea-plugin>